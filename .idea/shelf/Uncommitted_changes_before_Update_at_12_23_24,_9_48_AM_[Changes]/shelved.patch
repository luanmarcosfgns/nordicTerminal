+<template>
+  <div class="bg-display pt-4">
+    <div class="container">
+      <div class="card">
+        <div class="card-header text-center p-4">
+          <h3>{{ row?.nome }}</h3>
+        </div>
+        <div v-if="!displayNotifications" class="card-body">
+          <div class="row">
+            <input-form class-list="col-6" type="mask" mask="00.000.000/0000-00" label="CNPJ " value="" name="cnpj"/>
+            <input-form class-list="col-6" type="string" label="Nome " value="" name="nome"/>
+            <input-form class-list="col-6" type="string" label="E-mail " value="" name="email"/>
+            <input-form class-list="col-6" type="mask" mask="000.000.000-00" label="CPF " value="" name="cpf"/>
+            <input-form class-list="col-6" type="string" label="Telefone" value="" name="telefone_principal"/>
+            <input-form class-list="col-6" type="string" label="E-mail" value="" name="email_principal"/>
+          </div>
+        </div>
+        <div v-if="displayNotifications" class="card-body">
+          <div class="row">
+              <div class="col-12">
+                <h2>Solicitado com sucesso ✅</h2>
+              </div>
+          </div>
+        </div>
+        <div v-if="!displayNotifications" class="card-header">
+          <button @click="salvarForm" class="btn btn-success">Salvar</button>
+        </div>
+      </div>
+    </div>
+  </div>
+</template>
+<script>
+
+
+import produtoService from "@/services/produto.service";
+import InputForm from "@/components/form/inputForm.vue";
+import movimentoService from "@/services/movimento.service";
+
+export default {
+  name: "EcommerceToken",
+  data() {
+    return {
+      row: null,
+      displayNotifications:false
+    }
+  },
+  components: {InputForm},
+  methods: {
+    async ecommerce() {
+      let produtosService = new produtoService();
+      let response = await produtosService.ecommerce(this.$route.params.token);
+      this.row = await response.data;
+
+    },
+    async salvarForm(){
+      let payload = {};
+      payload.produto_id = this.row.id;
+      payload.unidade_id = this.row.unidade_id;
+      payload.nome = document.getElementById('nome').value;
+      payload.email = document.getElementById('email').value;
+      payload.cnpj = document.getElementById('cnpj').value;
+      payload.cpf = document.getElementById('cpf').value;
+      payload.telefone_principal = document.getElementById('telefone_principal').value;
+      payload.email_principal = document.getElementById('email_principal').value;
+
+      let movimentosService = new movimentoService();
+      movimentosService.save(payload);
+      this.displayNotifications = true;
+
+    }
+  },
+  async mounted() {
+    await this.ecommerce();
+  }
+}
+</script>
+<style scoped>
+.bg-display {
+  width: 100%;
+  height: 100%;
+  background-color: #efeded;
+  position: absolute;
+}
+</style>
