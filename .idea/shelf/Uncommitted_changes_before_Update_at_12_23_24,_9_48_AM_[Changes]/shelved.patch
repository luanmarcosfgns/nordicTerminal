<+><?php\n\nnamespace App\\Http\\Controllers;\n\nuse App\\Models\\TabelaPreco;\nuse Illuminate\\Support\\Facades\\DB;\nuse Illuminate\\View\\View;\nuse Illuminate\\Http\\Request;\nuse Illuminate\\Http\\JsonResponse;\n\n\nclass TabelaPrecoController extends Controller\n{\n    public function validated($type, $request)\n    {\n        if ($type == \"store\") {\n            $request->validate(\n                [\n                    'nome' => ['required', 'max:255', 'string'],\n                    'descritivo' => ['required', 'max:65535', 'string'],\n                    'ativo' => ['nullable', 'boolean'],\n                ]\n            );\n        } else {\n            $request->validate([\n                'nome' => ['nullable', 'max:255', 'string'],\n                'descritivo' => ['nullable', 'max:65535', 'string'],\n                'ativo' => ['nullable', 'boolean'],\n            ]);\n        }\n        return $request->only([\"nome\", \"descritivo\", \"created_user_id\", \"ativo\",'tipo']);\n    }\n\n    /**\n     * Display a listing of the resource.\n     */\n    public function index(Request $request): JsonResponse\n    {\n\n        $search = $request->get(\"search\", \"\");\n        if ($search == null) {\n            $search = \"\";\n        }\n        $tabela_precos = TabelaPreco::search($search)\n            ->where('tabela_precos.unidade_id',$request->user()->unidade_id)\n            ->orderBy('tabela_precos.id','desc')\n            ->paginate(1000);\n\n        return response()->json($tabela_precos);\n    }\n\n\n    /**\n     * Store a newly created resource in storage.\n     */\n    public function store(Request $request): JsonResponse\n    {\n\n        $validated = $this->validated(\"store\", $request);\n        $validated['created_user_id'] = $request->user()->id;\n        $validated['unidade_id'] = $request->user()->unidade_id;\n        $tabela_preco = TabelaPreco::create($validated);\n\n        return response()->json($tabela_preco);\n    }\n\n    /**\n     * Display the specified resource.\n     */\n    public function show(Request $request, $id): JsonResponse\n    {\n        $tabela_preco = TabelaPreco::find($id);\n\n        return response()->json($tabela_preco);\n    }\n\n\n    /**\n     * Update the specified resource in storage.\n     */\n    public function update(\n        Request $request,\n                $id\n    ): JsonResponse\n    {\n\n        $tabela_preco = TabelaPreco::find($id);\n        $validated = $this->validated(\"update\", $request);\n\n        $tabela_preco->update($validated);\n\n        return response()->json($tabela_preco);\n    }\n\n    /**\n     * Remove the specified resource from storage.\n     */\n    public function destroy(Request $request, $id): JsonResponse\n    {\n        $tabela_preco = TabelaPreco::find($id);\n        $tabela_preco->delete();\n\n        return response()->json([\"success\" => true, \"message\" => \"Removed success\"]);\n    }\n\n    public function find(Request $request)\n    {\n\n        if (!empty($request->search)) {\n            $rows = TabelaPreco::select('id as code', DB::raw('CONCAT(id,\"-\",nome) as label'))\n                ->limit(100)->where('nome', 'like', '%' . $request->search . '%')\n                ->where('tabela_precos.unidade_id',$request->user()->unidade_id)\n                ->get();\n            return response()->json($rows);\n        }\n\n        if (!empty($request->id)) {\n            $rows = TabelaPreco::select('id as code', DB::raw('CONCAT(id,\"-\",nome) as label'))\n                ->where('tabela_precos.unidade_id',$request->user()->unidade_id)\n                ->where('id', $request->id)\n                ->first();\n\n            return response()->json($rows);\n        }\n\n        $rows = TabelaPreco::select('id as code', DB::raw('CONCAT(id,\"-\",nome) as label'))\n            ->where('tabela_precos.unidade_id',$request->user()->unidade_id)\n            ->limit(25)\n            ->get();\n        return response()->json($rows);\n    }\n\n    public function movimentoTabela(Request $request,$produto_id)\n    {\n        $rows = TabelaPreco::join('tabela_precos_produtos','tabela_precos_produtos.tabela_preco_id','tabela_precos.id')\n            ->join('tabela_precos_unidades','tabela_precos_unidades.tabela_preco_id','tabela_precos.id')\n            ->select(\n                'tabela_precos.id',\n                'tabela_precos.nome',\n                'tabela_precos_produtos.valor_minimo',\n                'tabela_precos_produtos.desconto_maximo',\n            )\n            ->where('tabela_precos_produtos.produto_id',$produto_id)\n            ->where('tabela_precos_unidades.unidade_id',$request->user()->unidade_id)\n            ->where('tabela_precos.tipo',$request->tipo)\n            ->get();\n        return response($rows);\n    }\n\n\n}\n
